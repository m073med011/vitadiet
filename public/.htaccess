# Canonical origin: https://www.vitadiet.sa/ - must match nuxt.config.ts
# `site.url` and `i18n.baseUrl`, which already emit www-only canonical, hreflang,
# og:url, sitemap <loc> and JSON-LD values. Apache answers 200 on all four
# scheme/host variants, so without this file every page exists at four URLs and
# ranking signals split across them.
#
# Every rule redirects to the absolute canonical origin and ends in [L], so host,
# scheme and trailing slash are corrected in a single 301 - never a chain.
#
# No [NE] anywhere on purpose: REQUEST_URI is Apache's already-decoded r->uri, so
# letting mod_rewrite re-escape the substitution is what produces a valid
# Location header. Adding [NE] here would put raw UTF-8 bytes in the header for
# Arabic paths such as /ar/إلى/.
<IfModule mod_rewrite.c>
RewriteEngine On

# AutoSSL/ACME renewal is validated over plain http on the bare host too.
RewriteRule ^\.well-known/ - [L]

# Directory request missing the trailing slash that `trailingSlash: true`
# canonicalises to. Done here rather than left to mod_dir's DirectorySlash, which
# runs after this file and would cost a second hop when the host is also wrong.
# Skipped for subrequests so the internal DirectoryIndex lookup cannot loop.
RewriteCond %{IS_SUBREQ} !=true
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI}/ [R=301,L]

# Wrong host, any scheme. The original query string is re-appended automatically
# because the target contains no "?".
RewriteCond %{HTTP_HOST} !^www\.vitadiet\.sa$ [NC]
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI} [R=301,L]

# Right host, plain http. X-Forwarded-Proto is checked as well so terminating a
# TLS proxy in front of Apache later cannot turn this into a redirect loop.
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI} [R=301,L]
</IfModule>
