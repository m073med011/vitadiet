# VitaDiet production canonical redirects
# Production: https://www.vitadiet.sa/
# Development: the www.dev subdomain
#
# IMPORTANT:
# Production redirects are intentionally limited to vitadiet.sa and
# www.vitadiet.sa. The dev subdomain is never redirected to production.

ErrorDocument 404 /404.html

<IfModule mod_headers.c>
  # Keep production indexable; block indexing on dev/staging/subdomains.
  SetEnvIfNoCase Host "^(?!(?:www\.)?vitadiet\.sa(?::[0-9]+)?$).+" noindex_non_production
  Header set X-Robots-Tag "noindex, nofollow, noarchive" env=noindex_non_production

  # The partnership form handler is a transport, not a page. It must never be indexed
  # and must never be cached, in any environment.
  <FilesMatch "^partner-lead\.php$">
    Header always set X-Robots-Tag "noindex, nofollow"
    Header always set Cache-Control "no-store"
  </FilesMatch>
</IfModule>

<IfModule mod_rewrite.c>

RewriteEngine On

# AutoSSL / ACME validation
RewriteRule ^\.well-known/ - [L]

# ------------------------------------------------------------
# WITHDRAWN PRODUCTS -> PRODUCTS LISTING — PRODUCTION HOSTS ONLY
# floradit and flowadite were removed from the catalog on purpose.
# Their URLs were indexed, so they keep a 301 to the listing in the
# visitor's own language instead of falling through to 404.html.
# The legacy /ar/ prefix is folded in here to keep it a single hop.
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(?:www\.)?vitadiet\.sa$ [NC]
RewriteRule ^(?:ar/)?en/product/(?:floradit|flowadite)/?$ https://www.vitadiet.sa/en/products/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(?:www\.)?vitadiet\.sa$ [NC]
RewriteRule ^(?:ar/)?product/(?:floradit|flowadite)/?$ https://www.vitadiet.sa/products/ [R=301,L]

# ------------------------------------------------------------
# LEGACY /ar/ REDIRECTS — PRODUCTION HOSTS ONLY
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(?:www\.)?vitadiet\.sa$ [NC]
RewriteRule ^ar/?$ https://www.vitadiet.sa/ [R=301,L]

RewriteCond %{HTTP_HOST} ^(?:www\.)?vitadiet\.sa$ [NC]
RewriteRule ^ar/(.+)$ https://www.vitadiet.sa/$1 [R=301,L]

# ------------------------------------------------------------
# TRAILING SLASH — PRODUCTION HOSTS ONLY
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^(?:www\.)?vitadiet\.sa$ [NC]
RewriteCond %{IS_SUBREQ} !=true
RewriteCond %{REQUEST_FILENAME} -d
RewriteCond %{REQUEST_URI} !/$
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI}/ [R=301,L]

# ------------------------------------------------------------
# BARE DOMAIN -> WWW
# Only vitadiet.sa is redirected.
# Development subdomains are NOT matched.
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^vitadiet\.sa$ [NC]
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI} [R=301,L]

# ------------------------------------------------------------
# FORCE HTTPS ON WWW PRODUCTION HOST ONLY
# ------------------------------------------------------------
RewriteCond %{HTTP_HOST} ^www\.vitadiet\.sa$ [NC]
RewriteCond %{HTTPS} !=on
RewriteCond %{HTTP:X-Forwarded-Proto} !=https
RewriteRule ^ https://www.vitadiet.sa%{REQUEST_URI} [R=301,L]

</IfModule>
