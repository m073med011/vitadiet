{
  "name": "vitadiet",
  "type": "module",
  "private": true,
  "scripts": {
    "build": "nuxt build && npm run test:catalog && npm run test:content && npm run test:contrast && npm run test:urls && npm run test:schema && npm run test:i18n && npm run test:site-url && npm run test:delivery",
    "dev": "nuxt dev",
    "generate": "nuxt generate && npm run test:catalog && npm run test:content && npm run test:contrast && npm run test:urls && npm run test:schema && npm run test:i18n && npm run test:site-url && npm run test:delivery",
    "preview": "nuxt preview",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "typecheck": "nuxt typecheck",
    "postinstall": "nuxt prepare",
    "test:urls": "node scripts/check-no-localhost.mjs",
    "test:schema": "node scripts/check-schema-org.mjs",
    "test:i18n": "node scripts/check-i18n-keys.mjs",
    "test:site-url": "node scripts/check-site-url-sync.mjs",
    "test:delivery": "node scripts/check-delivery.mjs",
    "test:catalog": "node scripts/check-product-catalog.mjs",
    "test:contrast": "node scripts/check-contrast.mjs",
    "test:content": "node scripts/check-site-content.mjs"
  },
  "dependencies": {
    "@nuxt/fonts": "^0.14.0",
    "@nuxt/image": "^2.0.0",
    "@nuxtjs/i18n": "^10.3.0",
    "@nuxtjs/seo": "^5.1.3",
    "@tailwindcss/vite": "^4.2.4",
    "lucide-vue-next": "^1.0.0",
    "nuxt": "^4.4.6",
    "tailwindcss": "^4.2.4",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@nuxt/eslint": "^1.17.0",
    "eslint": "^10.9.0",
    "prettier": "^3.9.6",
    "typescript": "^6.0.3",
    "vue-tsc": "^3.3.11"
  }
}
